#!/bin/sh
# Format staged files with Prettier and re-stage them.
# Binaries are called directly (husky adds node_modules/.bin to PATH):
# `npm run` kills the hook shell under GitHub Desktop's bundled Git.
git diff --cached --name-only --diff-filter=ACMR -z \
    | xargs -0 -r prettier --config .prettierrc --log-level warn --ignore-unknown --no-color --write --
git diff --cached --name-only --diff-filter=ACMR -z \
    | xargs -0 -r git add --
